#!/bin/bash
# Cloud-init bootstrap for a repo-dev-runtime autonomous-operation instance.
# Generated by Terraform (infra/aws/templates/user_data.sh.tftpl) - do not
# hand-edit the rendered copy on the instance; change the template and
# re-apply instead.
set -euo pipefail

RUNTIME_USER=repo-dev-runtime
INSTALL_ROOT=/opt/repo-dev-runtime
STATE_DIR=/var/lib/repo-dev-runtime
TARGET_DIR="$INSTALL_ROOT/target"

dnf install -y python3.11 python3.11-pip git >/dev/null

id -u "$RUNTIME_USER" >/dev/null 2>&1 || useradd --system --create-home --shell /usr/sbin/nologin "$RUNTIME_USER"

python3.11 -m venv "$INSTALL_ROOT/venv"
"$INSTALL_ROOT/venv/bin/pip" install --quiet --upgrade pip
"$INSTALL_ROOT/venv/bin/pip" install --quiet "${runtime_pip_spec}"

mkdir -p "$STATE_DIR/runs"
chown -R "$RUNTIME_USER":"$RUNTIME_USER" "$STATE_DIR" "$INSTALL_ROOT"

if [ ! -d "$TARGET_DIR/.git" ]; then
  sudo -u "$RUNTIME_USER" git clone "${target_repo_url}" "$TARGET_DIR"
fi
cd "$TARGET_DIR"
sudo -u "$RUNTIME_USER" git fetch origin "${target_repo_ref}" --quiet
sudo -u "$RUNTIME_USER" git checkout "${target_repo_ref}" --quiet
sudo -u "$RUNTIME_USER" git reset --hard "origin/${target_repo_ref}" --quiet

if [ ! -f "$TARGET_DIR/.dev-runtime/repository.json" ]; then
  sudo -u "$RUNTIME_USER" "$INSTALL_ROOT/venv/bin/python3.11" -m repo_dev_runtime.cli init-manifest "$TARGET_DIR" >/dev/null
  sudo -u "$RUNTIME_USER" python3.11 - "$TARGET_DIR/.dev-runtime/repository.json" <<'PYEOF'
import json, sys
path = sys.argv[1]
data = json.load(open(path))
data["pull_request_creation"] = True
json.dump(data, open(path, "w"), indent=2)
PYEOF
fi

cat > "$INSTALL_ROOT/run-once.sh" <<EOF
#!/usr/bin/env bash
set -euo pipefail

export GITHUB_TOKEN=\$(aws secretsmanager get-secret-value --region "${aws_region}" --secret-id "${github_token_secret_name}" --query SecretString --output text)
export DEV_OMNIROUTE_TOKEN=\$(aws secretsmanager get-secret-value --region "${aws_region}" --secret-id "${openrouter_key_secret_name}" --query SecretString --output text)
export DEV_OMNIROUTE_URL=https://openrouter.ai/api/v1
export DEV_OMNIROUTE_MODEL="${openrouter_model}"
export DEV_OMNIROUTE_ENABLED=true
export OLLAMA_URL=\$(aws ssm get-parameter --region "${aws_region}" --name "${ollama_url_parameter_name}" --with-decryption --query Parameter.Value --output text)
export DEV_RUNTIME_OLLAMA=true

STATE_FILE="$STATE_DIR/state.json"

# Reap a claim left at "running" by a crash or a killed instance, via
# TaskStateStore.reap_stuck() rather than a hand-rolled unlocked
# read/write, which could corrupt or lose a concurrent claim()/update()
# call. See docs/aws-autonomous-deployment.md's "known gap" section.
"$INSTALL_ROOT/venv/bin/python3.11" -c "
from repo_dev_runtime.scheduler import TaskStateStore
TaskStateStore('\$STATE_FILE').reap_stuck('${schedule_key}', timeout_s=${reap_stuck_timeout_s})
"

cd "$TARGET_DIR"
git fetch origin "${target_repo_ref}" --quiet
git checkout "${target_repo_ref}" --quiet
git reset --hard "origin/${target_repo_ref}" --quiet

"$INSTALL_ROOT/venv/bin/python3.11" -m repo_dev_runtime.cli run . \\
  --prompt "${run_prompt}" \\
  --base-ref "${target_repo_ref}" \\
  --live --enable-omniroute --enable-ollama --approve-paid \\
  --apply-edits --create-pr \\
  --scheduler-state-file "\$STATE_FILE" \\
  --schedule-key "${schedule_key}" \\
  --artifacts-root "$STATE_DIR/runs"
EOF
chmod +x "$INSTALL_ROOT/run-once.sh"
chown "$RUNTIME_USER":"$RUNTIME_USER" "$INSTALL_ROOT/run-once.sh"

cat > /etc/systemd/system/repo-dev-runtime.service <<EOF
[Unit]
Description=repo-dev-runtime scheduled autonomous pass

[Service]
Type=oneshot
User=$RUNTIME_USER
ExecStart=$INSTALL_ROOT/run-once.sh
EOF

cat > /etc/systemd/system/repo-dev-runtime.timer <<EOF
[Unit]
Description=repo-dev-runtime scheduled autonomous pass timer

[Timer]
OnCalendar=${schedule_oncalendar}
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now repo-dev-runtime.timer
